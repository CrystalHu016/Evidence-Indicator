            \{\
              "text": "06\uc0\u12304 STAY\u12305 \u23487 \u12399 \u12393 \u12358 \u12375 \u12383 \u12425 \u12356 \u12356 \u65311 ",\
              "referred": false\
            \},\
            \{\
              "text": "07\uc0\u12304 ACCESS\u12305 \u37117 \u20869 \u12363 \u12425 \u12398 \u12450 \u12463 \u12475 \u12473 \u12399 \u65311 ",\
              "referred": false\
            \},\
            \{\
              "text": "08\uc0\u12304 STYLE\u12305 \u12393 \u12435 \u12394 \u26381 \u35013 \u12391 \u34892 \u12367 \u12398 \u12364 \u12356 \u12356 \u65311 ",\
              "referred": false\
            \},\
            \{\
              "text": "09\uc0\u12304 TIPS\u12305 \u19978 \u39640 \u22320 \u12391 \u12399 \u37326 \u29983 \u21205 \u29289 \u12395 \u20250 \u12360 \u12427 \u65311 ",\
              "referred": false\
            \},\
            \{\
              "text": "10\uc0\u12304 PICK UP\u12305 \u19978 \u39640 \u22320 \u12398 \u26368 \u26032 \u12491 \u12517 \u12540 \u12473 ",\
              "referred": false\
            \},\
            \{\
              "text": "01\uc0\u12304 WHAT\u12305 \u19978 \u39640 \u22320 \u12387 \u12390 \u12393 \u12435 \u12394 \u12392 \u12371 \u12429 \u65311 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u22812 \u12398 \u22823 \u27491 \u27744 \u12290 \u31354 \u27671 \u12364 \u28548 \u12435 \u12391 \u12356 \u12427 \u12383 \u12417 \u12289 \u22825 \u27671 \u12364 \u12424 \u12369 \u12428 \u12400 \u28288 \u22825 \u12398 \u26143 \u12434 \u27005 \u12375 \u12417 \u12414 \u12377  \'a9\u19978 \u39640 \u22320 \u35251 \u20809 \u26053 \u39208 \u32068 \u21512 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u38263 \u37326 \u30476 \u26494 \u26412 \u24066 \u12395 \u12354 \u12427 \u12289 \u26085 \u26412 \u12434 \u20195 \u34920 \u12377 \u12427 \u23665 \u23731 \u26223 \u21213 \u22320 \u12290 \u24180 \u38291 120\u19975 \u20154 \u12434 \u36229 \u12360 \u12427 \u35251 \u20809 \u23458 \u12420 \u30331 \u23665 \u23458 \u12364 \u12289 \u32118 \u26223 \u12434 \u27714 \u12417 \u12390 \u12371 \u12398 \u22320 \u12434 \u35370 \u12428 \u12414 \u12377 \u12290 \u27671 \u12414 \u12414 \u12395 \u25955 \u31574 \u12434 \u27005 \u12375 \u12435 \u12384 \u12426 \u12289 \u26412 \u26684 \u30340 \u12394 \u30331 \u23665 \u12395 \u25361 \u25126 \u12375 \u12383 \u12426 \u12289 \u23487 \u12395 \u27850 \u12414 \u12387 \u12390 \u26143 \u31354 \u12434 \u22570 \u33021 \u12375 \u12383 \u12426 \u12392 \u12289 \u12373 \u12414 \u12374 \u12414 \u12394 \u12473 \u12479 \u12452 \u12523 \u12391 \u22823 \u33258 \u28982 \u12434 \u28288 \u21931 \u12391 \u12365 \u12414 \u12377 \u12290 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u19978 \u39640 \u22320 \u12456 \u12522 \u12450 \u12395 \u20837 \u12428 \u12427 \u12398 \u12399 \u12289 \u20363 \u24180 4\u26376 \u20013 \u26092 \u65374 11\u26376 15\u26085 \u12290 \u26149 \u12398 \u12458 \u12540 \u12503 \u12531 \u26178 \u26399 \u12399 \u30476 \u36947 \u12398 \u19978 \u39640 \u22320 \u20844 \u22290 \u32218 \u12398 \u38283 \u36890 \u26085 \u12395 \u12424 \u12387 \u12390 \u21069 \u24460 \u12377 \u12427 \u12383 \u12417 \u12289 \u35370 \u12428 \u12427 \u38555 \u12395 \u12399 \u20844 \u24335 \u12469 \u12452 \u12488 \u12434 \u12481 \u12455 \u12483 \u12463 \u12375 \u12414 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "02\uc0\u12304 WATCH\u12305 \u20309 \u12364 \u35211 \u12425 \u12428 \u12427 \u65311 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u32654 \u12375 \u12356 \u22823 \u33258 \u28982 \u12395 \u20986 \u20250 \u12360 \u12414 \u12377  \'a9\u19978 \u39640 \u22320 \u35251 \u20809 \u26053 \u39208 \u32068 \u21512 ",\
              "referred": true,\
              "unconfident": true\
            \},\
            \{\
              "text": "\uc0\u19978 \u39640 \u22320 \u12395 \u12399 \u12289 \u38596 \u22823 \u12394 \u23665 \u12293 \u12434 \u12399 \u12376 \u12417 \u12289 \u32654 \u12375 \u12356 \u27744 \u12420 \u28287 \u21407 \u12289 \u24029 \u12398 \u28165 \u27969 \u12394 \u12393 \u12373 \u12414 \u12374 \u12414 \u12394 \u32118 \u26223 \u12473 \u12509 \u12483 \u12488 \u12364 \u23384 \u22312 \u12375 \u12414 \u12377 \u12290 \u12381 \u12398 \u19978 \u12289 \u22825 \u27671 \u12420 \u35370 \u12428 \u12427 \u26178 \u38291 \u24111 \u12395 \u12424 \u12387 \u12390 \u12418 \u12460 \u12521 \u12522 \u12392 \u34920 \u24773 \u12434 \u22793 \u12360 \u12427 \u12383 \u12417 \u12289 \u35211 \u39165 \u12365 \u12427 \u12371 \u12392 \u12364 \u12354 \u12426 \u12414 \u12379 \u12435 \u12290 \u12414 \u12378 \u12399 \u12289 \u12399 \u12376 \u12417 \u12390 \u12398 \u19978 \u39640 \u22320 \u12392 \u12356 \u12358 \u26041 \u12395 \u12380 \u12402 \u35370 \u12428 \u12390 \u12411 \u12375 \u12356 \u12473 \u12509 \u12483 \u12488 \u12420 \u12362 \u12377 \u12377 \u12417 \u12523 \u12540 \u12488 \u12434 \u12372 \u32057 \u20171 \u12375 \u12414 \u12377 \u12290 ",\
