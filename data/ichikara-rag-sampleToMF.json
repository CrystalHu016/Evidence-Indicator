            \},\
            \{\
              "text": "04\uc0\u12304 HOW 02\u12305 \u20154 \u27671 \u12398 \u27005 \u12375 \u12415 \u26041 \u12399 \u65311 ",\
              "referred": false\
            \},\
            \{\
              "text": "05\uc0\u12304 FOOD\u12305 \u12393 \u12435 \u12394 \u12464 \u12523 \u12513 \u12364 \u21619 \u12431 \u12360 \u12427 \u65311 ",\
              "referred": false\
