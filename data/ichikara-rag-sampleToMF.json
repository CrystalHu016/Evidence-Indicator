            \{\
              "text": "\uc0\u12399 \u12376 \u12417 \u12390 \u12398 \u19978 \u39640 \u22320 \u35251 \u20809 \u12395 \u12362 \u12377 \u12377 \u12417 \u12375 \u12383 \u12356 \u12398 \u12364 \u12289 1\u26178 \u38291 \u65374 2\u26178 \u38291 \u12411 \u12393 \u12398 \u31777 \u21336 \u12454 \u12457 \u12540 \u12461 \u12531 \u12464 \u12467 \u12540 \u12473 \u12290 \u26222 \u27573 \u30528 \u12391 \u12289 \u28961 \u29702 \u12379 \u12378 \u12395 \u33258 \u28982 \u12434 \u27005 \u12375 \u12417 \u12414 \u12377 \u12290 ",\
