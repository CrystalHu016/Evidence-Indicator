            \},\
            \{\
              "text": "\uc0\u65297 \u65294 \u22823 \u27491 \u27744 \u65374 \u27827 \u31461 \u27211 \u12467 \u12540 \u12473 \u65288 1\u26178 \u38291 10\u20998 \u31243 \u24230 \u65289 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u22823 \u27491 \u27744 \u12496 \u12473 \u20572 \u8594 \u12296 \u22823 \u27491 \u27744 \u12297 \u8594 \u30000 \u20195 \u28287 \u21407 \u12296 \u30000 \u20195 \u27744 \u12297 \u8594 \u12296 \u30000 \u20195 \u27211 \u12297 \u8594 \u12296 \u27827 \u31461 \u27211 \u12297 \u8594 \u19978 \u39640 \u22320 \u12496 \u12473 \u12479 \u12540 \u12511 \u12490 \u12523 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u20132 \u36890 \u27231 \u38306 \u12434 \u12388 \u12363 \u12387 \u12390 \u19978 \u39640 \u22320 \u12398 \u12456 \u12522 \u12450 \u12395 \u20837 \u12426 \u12289 \u22823 \u27491 \u27744 \u12398 \u12496 \u12473 \u20572 \u12395 \u12390 \u19979 \u36554 \u12290 \u19978 \u27969 \u12398 \u12296 \u27827 \u31461 \u27211 \u12297 \u12395 \u12416 \u12363 \u12387 \u12390 \u27497 \u12367 \u12467 \u12540 \u12473 \u12290 \u12399 \u12376 \u12417 \u12390 \u12398 \u19978 \u39640 \u22320 \u12392 \u12356 \u12358 \u26041 \u12395 \u12418 \u12362 \u12377 \u12377 \u12417 \u12290 \u21069 \u26041 \u12395 \u19978 \u39640 \u22320 \u12434 \u20195 \u34920 \u12377 \u12427 \u23665 \u23731 \u32654 \u12296 \u31298 \u39640 \u36899 \u23792 \u12297 \u12434 \u30522 \u12417 \u12394 \u12364 \u12425 \u27497 \u12369 \u12414 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u65298 \u65294 \u27827 \u31461 \u27211 \u65374 \u26126 \u31070 \u27744 \u12467 \u12540 \u12473 \u65288 2\u26178 \u38291 \u31243 \u24230 \u65372 \u34892 \u12365 70\u20998 \u12539 \u24112 \u12426 60\u20998 \u65289 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u19978 \u39640 \u22320 \u12496 \u12473 \u12479 \u12540 \u12511 \u12490 \u12523 \u8594 \u12296 \u27827 \u31461 \u27211 \u12297 \u8594 \u26771 \u24029 \u65288 \u21491 \u23736 \u65289 \u8594 \u12296 \u23731 \u27810 \u28287 \u21407 \u12297 \u8594 \u12296 \u26126 \u31070 \u27744 \u12297 \u8594 \u26771 \u24029 \u65288 \u24038 \u23736 \u65289 \u8594 \u19978 \u39640 \u22320 \u12496 \u12473 \u12479 \u12540 \u12511 \u12490 \u12523 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u20132 \u36890 \u27231 \u38306 \u12434 \u12388 \u12363 \u12387 \u12390 \u19978 \u39640 \u22320 \u12398 \u12456 \u12522 \u12450 \u12395 \u20837 \u12426 \u12289 \u19978 \u39640 \u22320 \u12496 \u12473 \u12479 \u12540 \u12511 \u12490 \u12523 \u12391 \u19979 \u36554 \u12290 \u24466 \u27497 5\u20998 \u12398 \u12392 \u12371 \u12429 \u12395 \u12354 \u12427 \u12296 \u27827 \u31461 \u27211 \u12297 \u12363 \u12425 \u12289 \u26771 \u24029 \u12398 \u21491 \u23736 \u12434 \u36890 \u12387 \u12390 \u12296 \u26126 \u31070 \u27744 \u12297 \u12434 \u30446 \u25351 \u12377 \u12467 \u12540 \u12473 \u12290 \u12296 \u26126 \u31070 \u27744 \u12297 \u12414 \u12391 \u12399 \u34892 \u12365 \u24112 \u12426 \u24466 \u27497 \u12398 \u12415 \u12394 \u12398 \u12391 \u12289 \u12418 \u12358 \u23569 \u12375 \u12375 \u12387 \u12363 \u12426 \u27497 \u12365 \u12383 \u12356 \u12392 \u12356 \u12358 \u26041 \u12395 \u12362 \u12377 \u12377 \u12417 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u23567 \u24029 \u12398 \u12379 \u12379 \u12425 \u12366 \u12434 \u32862 \u12365 \u12394 \u12364 \u12425 \u26408 \u36947 \u12434 \u27497 \u12365 \u32154 \u12369 \u12427 \u12392 \u12289 \u31070 \u31192 \u30340 \u12394 \u26126 \u31070 \u12456 \u12522 \u12450 \u12395 \u12290 \u12296 \u26126 \u31070 \u27744 \u12297 \u12398 \u12411 \u12392 \u12426 \u12395 \u12399 \u12296 \u31298 \u39640 \u31070 \u31038 \u12297 \u12364 \u12354 \u12426 \u12289 \u25309 \u35251 \u26009 500\u20870 \u12391 \u20837 \u12428 \u12414 \u12377 \u12290 \u24112 \u12426 \u36947 \u12395 \u12399 \u12289 \u12296 \u26126 \u31070 \u23731 \u12297 \u12420 \u23550 \u23736 \u12395 \u12381 \u12403 \u12360 \u12427 \u12296 \u31298 \u39640 \u36899 \u23792 \u12297 \u12434 \u21029 \u35282 \u24230 \u12363 \u12425 \u26395 \u12417 \u12414 \u12377 \u12290 ",\
