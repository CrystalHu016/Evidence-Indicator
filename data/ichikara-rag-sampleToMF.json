            \{\
              "text": "\uc0\u23731 \u27810 \u28287 \u21407 \u27827 \u31461 \u27211 \u12434 \u28193 \u12426 \u12289 \u26771 \u24029 \u12398 \u21491 \u23736 \u12434 \u26126 \u31070 \u26041 \u38754 \u12395 15\u20998 \u12411 \u12393 \u27497 \u12367 \u12392 \u29694 \u12428 \u12427 \u12296 \u23731 \u27810 \u28287 \u21407 \u65288 \u12384 \u12369 \u12373 \u12431 \u12539 \u12375 \u12388 \u12370 \u12435 \u65289 \u12297 \u12290 \u21407 \u29983 \u26519 \u12395 \u22258 \u12414 \u12428 \u12383 \u23567 \u12373 \u12394 \u28287 \u21407 \u12391 \u12289 \u36879 \u26126 \u24863 \u12354 \u12405 \u12428 \u12427 \u28165 \u12425 \u12363 \u12394 \u28263 \u27700 \u12399 \u12289 \u26085 \u12364 \u23556 \u12377 \u12411 \u12393 \u12395 \u38738 \u12373 \u12434 \u22679 \u12375 \u12390 \u24687 \u12434 \u21585 \u12416 \u32654 \u12375 \u12373 \u12391 \u12377 \u12290 \u12381 \u12398 \u12383 \u12417 \u12289 \u20809 \u12364 \u23556 \u12375 \u36796 \u12416 \u26397 \u26041 \u12395 \u35370 \u12428 \u12427 \u12398 \u12364 \u12362 \u12377 \u12377 \u12417 \u12290 \u23637 \u26395 \u12454 \u12483 \u12489 \u12487 \u12483 \u12461 \u12391 \u12380 \u12402 \u35352 \u24565 \u20889 \u30495 \u12434 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u26126 \u31070 \u27744 \u37341 \u33865 \u27193 \u12395 \u22258 \u12414 \u12428 \u12383 \u31070 \u31192 \u30340 \u12394 \u27744 \u12296 \u26126 \u31070 \u27744 \u12297 \u12290 \u36879 \u26126 \u24863 \u12354 \u12405 \u12428 \u12427 \u27700 \u38754 \u12395 \u12399 \u28548 \u12415 \u28193 \u12387 \u12383 \u31354 \u12364 \u26144 \u12426 \u12289 \u26132 \u12399 \u12317 \u37857 \u27744 \u12319 \u12392 \u21628 \u12400 \u12428 \u12390 \u12356 \u12383 \u12381 \u12358 \u12290 \u26126 \u31070 \u19968 \u24111 \u12399 \u12289 \u26126 \u31070 \u23731 \u12434 \u12372 \u31070 \u20307 \u12392 \u12375 \u12383 \u12296 \u31298 \u39641 \u31070 \u31038 \u12297 \u22885 \u23470 \u12398 \u31070 \u22495 \u12391 \u12289 \u12497 \u12527 \u12540 \u12473 \u12509 \u12483 \u12488 \u12392 \u12375 \u12390 \u12418 \u30693 \u12425 \u12428 \u12390 \u12356 \u12414 \u12377 \u12290 \u31070 \u32854 \u12394 \u31354 \u27671 \u12364 \u28418 \u12358 \u12371 \u12398 \u22320 \u12395 \u12399 \u12289 \u26893 \u29289 \u12420 \u37326 \u40165 \u12398 \u31278 \u39006 \u12418 \u22810 \u12367 \u12422 \u12387 \u12367 \u12426 \u12392 \u25955 \u31574 \u12434 \u27005 \u12375 \u12417 \u12414 \u12377 \u12290 ",\
