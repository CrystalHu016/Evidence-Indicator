            \{\
              "text": "\uc0\u19978 \u39640 \u22320 \u12434 \u30693 \u12426 \u23613 \u12367 \u12375 \u12383 \u12503 \u12525 \u12460 \u12452 \u12489 \u12364 \u12473 \u12509 \u12483 \u12488 \u12420 \u26893 \u29289 \u12289 \u40165 \u12394 \u12393 \u12395 \u12388 \u12356 \u12390 \u35299 \u35500 \u12375 \u12394 \u12364 \u12425 \u26696 \u20869 \u12434 \u12375 \u12390 \u12367 \u12428 \u12427 \u12300 \u12460 \u12452 \u12489 \u12454 \u12457 \u12540 \u12463 \u12301 \u12364 \u12354 \u12426 \u12414 \u12377 \u12290 \u21442 \u21152 \u12377 \u12427 \u12392 \u12424 \u12426 \u28145 \u12367 \u19978 \u39640 \u22320 \u12434 \u30693 \u12427 \u12371 \u12392 \u12364 \u12391 \u12365 \u12414 \u12377 \u12290 \u19978 \u39640 \u22320 \u12499 \u12472 \u12479 \u12540 \u12475 \u12531 \u12479 \u12540 \u12398 \u12411 \u12363 \u12289 \u21508 \u12507 \u12486 \u12523 \u12391 \u12418 \u12460 \u12452 \u12489 \u12454 \u12457 \u12540 \u12463 \u12434 \u23455 \u26045 \u12290 \u23455 \u26045 \u26178 \u38291 \u12364 \u30064 \u12394 \u12427 \u12398 \u12391 \u12289 \u24403 \u26085 \u12398 \u26085 \u31243 \u12420 \u34892 \u12365 \u12383 \u12356 \u12473 \u12509 \u12483 \u12488 \u12395 \u21512 \u12431 \u12379 \u12390 \u36984 \u12403 \u12414 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u22823 \u33258 \u28982 \u12398 \u12394 \u12363 \u12391 \u12461 \u12515 \u12531 \u12503 \u12434 \u27005 \u12375 \u12416 ",\
