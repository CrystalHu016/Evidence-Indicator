            \{\
              "text": "\uc0\u12399 \u12376 \u12417 \u12390 \u12398 \u19978 \u39640 \u22320 \u12460 \u12452 \u12489 \u65374 \u12362 \u12377 \u12377 \u12417 \u12398 10\u12450 \u12452 \u12487 \u12450 \u65374 ",\
