            \{\
              "text": "\uc0\u12460 \u12452 \u12489 \u12502 \u12483 \u12463 \u12434 \u25345 \u12385 \u12394 \u12364 \u12425 \u33258 \u30001 \u12395 \u25955 \u31574 \u12434 \u12377 \u12427 \u12398 \u12399 \u12418 \u12385 \u12429 \u12435 \u12398 \u12371 \u12392 \u12289 \u12411 \u12363 \u12395 \u12418 \u12373 \u12414 \u12374 \u12414 \u12394 \u27005 \u12375 \u12415 \u26041 \u12364 \u12354 \u12426 \u12414 \u12377 \u12290 \u20107 \u21069 \u12395 \u30693 \u12387 \u12390 \u12362 \u12367 \u12392 \u12289 \u19978 \u39640 \u22320 \u12391 \u36942 \u12372 \u12377 \u26178 \u38291 \u12364 \u12373 \u12425 \u12395 \u27005 \u12375 \u12367 \u12394 \u12427 \u12450 \u12452 \u12487 \u12450 \u12434 \u12372 \u32057 \u20171 \u12375 \u12414 \u12377 \u12290 ",\
              "referred": false\
