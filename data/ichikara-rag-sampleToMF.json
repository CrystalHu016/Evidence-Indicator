              "text": "\uc0\u31298 \u39640 \u36899 \u23792 \u19978 \u39640 \u22320 \u12398 \u33267 \u12427 \u12392 \u12371 \u12429 \u12363 \u12425 \u26395 \u12417 \u12427 \u38596 \u22823 \u12394 \u23665 \u31260 \u12364 \u12296 \u31298 \u39640 \u36899 \u23792 \u12297 \u12290 \u35211 \u12427 \u35282 \u24230 \u12395 \u12424 \u12387 \u12390 \u36949 \u12358 \u19968 \u38754 \u12434 \u35211 \u12379 \u12427 \u12398 \u12391 \u12289 \u20309 \u24230 \u12418 \u20889 \u30495 \u12395 \u12362 \u12373 \u12417 \u12383 \u12367 \u12394 \u12427 \u12371 \u12392 \u12414 \u12385 \u12364 \u12356 \u12394 \u12375 \u12290 \u26085 \u26412 \u12434 \u20195 \u34920 \u12377 \u12427 \u23721 \u22721 \u12364 \u12381 \u12429 \u12358 \u12296 \u31298 \u39640 \u36899 \u23792 \u12297 \u12399 \u12289 \u12450 \u12523 \u12500 \u12491 \u12473 \u12488 \u12398 \u24999 \u12428 \u12391 \u12418 \u12354 \u12426 \u12414 \u12377 \u12290 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u31298 \u39640 \u36899 \u23792  \'a9\u65288 \u19968 \u31038 \u65289 \u26494 \u26412 \u24066 \u12450 \u12523 \u12503 \u12473 \u23665 \u23731 \u37111 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u22823 \u27491 \u27744 \u28988 \u23731 \u12392 \u31298 \u39640 \u36899 \u23792 \u12434 \u28246 \u38754 \u12395 \u32654 \u12375 \u12367 \u26144 \u12375 \u20986 \u12377 \u31070 \u31192 \u12398 \u27744 \u12296 \u22823 \u27491 \u27744 \u12297 \u12290 1915\u24180 \u12398 \u28988 \u23731 \u12398 \u22132 \u28779 \u12391 \u27877 \u27969 \u12364 \u26771 \u24029 \u12434 \u12379 \u12365 \u12392 \u12417 \u12390 \u12391 \u12365 \u12383 \u12371 \u12398 \u27744 \u12399 \u12289 \u35370 \u12428 \u12427 \u26178 \u38291 \u12395 \u12424 \u12387 \u12390 \u12414 \u12387 \u12383 \u12367 \u30064 \u12394 \u12427 \u34920 \u24773 \u12434 \u35211 \u12379 \u12414 \u12377 \u12290 \u12418 \u12385 \u12429 \u12435 \u26228 \u12428 \u12383 \u26172 \u38291 \u12418 \u32654 \u12375 \u12356 \u12391 \u12377 \u12364 \u12289 \u12362 \u12377 \u12377 \u12417 \u12399 \u26089 \u26397 \u12392 \u22812 \u12290 \u38632 \u19978 \u12364 \u12426 \u12395 \u12399 \u24187 \u24819 \u30340 \u12394 \u26397 \u12418 \u12420 \u12392 \u12289 \u28288 \u22825 \u12398 \u26143 \u12434 \u27005 \u12375 \u12417 \u12414 \u12377 \u12290 \u19978 \u39640 \u22320 \u12395 \u35370 \u12428 \u12383 \u12425 \u19968 \u24230 \u12399 \u35211 \u12390 \u12411 \u12375 \u12356 \u12473 \u12509 \u12483 \u12488 \u12391 \u12377 \u12290 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u30000 \u20195 \u28287 \u21407 \u12296 \u30000 \u20195 \u27744 \u12297 \u22823 \u27491 \u27744 \u12363 \u12425 15\u20998 \u12411 \u12393 \u27497 \u12367 \u12392 \u12289 \u31361 \u28982 \u35222 \u30028 \u12364 \u38283 \u12369 \u12390 \u29694 \u12428 \u12427 \u30000 \u20195 \u28287 \u21407 \u12296 \u30000 \u20195 \u27744 \u12297 \u12290 \u21407 \u29983 \u26519 \u12398 \u12394 \u12363 \u12395 \u12413 \u12387 \u12363 \u12426 \u12392 \u31354 \u12356 \u12383 \u28287 \u21407 \u12395 \u24195 \u12364 \u12427 \u27744 \u12399 \u12289 \u24187 \u24819 \u30340 \u12394 \u38640 \u22258 \u27671 \u12395 \u21253 \u12414 \u12428 \u12390 \u12356 \u12414 \u12377 \u12290 \u23395 \u31680 \u12395 \u12424 \u12387 \u12390 \u22235 \u23395 \u25240 \u12293 \u12398 \u24425 \u12426 \u12434 \u27005 \u12375 \u12417 \u12427 \u12398 \u12418 \u12509 \u12452 \u12531 \u12488 \u12290 \u27703 \u28857 \u19979 \u12395 \u12394 \u12427 \u23395 \u31680 \u12395 \u12399 \u12289 \u38695 \u27703 \u12395 \u21253 \u12414 \u12428 \u12383 \u26408 \u12293 \u12364 \u32654 \u12375 \u12356 \u37504 \u19990 \u30028 \u12398 \u36637 \u12365 \u12434 \u35211 \u12379 \u12414 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u22823 \u27491 \u27744  \'a9\u19978 \u39640 \u22320 \u35251 \u20809 \u26053 \u39208 \u32068 \u21512 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u30000 \u20195 \u28287 \u21407 \u12296 \u30000 \u20195 \u27744 \u12297  \'a9\u19978 \u39640 \u22320 \u35251 \u20809 \u26053 \u39208 \u32068 \u21512 ",\
              "referred": false\
