            "\uc0\u12473 \u12525 \u12540 \u12460 \u12531 \u12395 \u20351 \u12360 \u12427 \u22235 \u25991 \u23383 \u29087 \u35486 \u65281 \u31532 2\u20301 \u65306 \u30142 \u39080 \u36805 \u38647 ",\
