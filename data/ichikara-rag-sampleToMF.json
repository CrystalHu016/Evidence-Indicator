            \{\
              "text": "\uc0\u22269 \u31435 \u20844 \u22290 \u20869 \u12395 \u12399 \u12289 \u32118 \u26223 \u12434 \u30522 \u12417 \u12394 \u12364 \u12425 \u27005 \u12375 \u12417 \u12427 3\u12388 \u12398 \u12461 \u12515 \u12531 \u12503 \u22580 \u12364 \u12354 \u12426 \u12414 \u12377 \u12290 \u21021 \u24515 \u32773 \u12395 \u12362 \u12377 \u12377 \u12417 \u12394 \u12398 \u12399 \u12289 \u12296 \u23567 \u26792 \u24179 \u12461 \u12515 \u12531 \u12503 \u22580 \u12297 \u12290 \u12296 \u31298 \u39640 \u36899 \u23792 \u12297 \u12434 \u21069 \u26041 \u12395 \u30522 \u12417 \u12425 \u12428 \u12427 \u12525 \u12465 \u12540 \u12471 \u12519 \u12531 \u12394 \u12364 \u12425 \u12289 \u12496 \u12473 \u12479 \u12540 \u12511 \u12490 \u12523 \u12363 \u12425 10\u20998 \u12392 \u12450 \u12463 \u12475 \u12473 \u12418 \u33391 \u22909 \u12290 \u12362 \u39080 \u21570 \u12420 \u39135 \u22530 \u12289 \u12461 \u12515 \u12531 \u12503 \u29992 \u21697 \u12398 \u12524 \u12531 \u12479 \u12523 \u12394 \u12393 \u35373 \u20633 \u12418 \u25972 \u12387 \u12390 \u12356 \u12427 \u12398 \u12391 \u12289 \u24555 \u36969 \u12395 \u12461 \u12515 \u12531 \u12503 \u12434 \u27005 \u12375 \u12417 \u12414 \u12377 \u12290 ",\
