            \{\
              "text": "\uc0\u21451 \u20154 \u12420 \u30693 \u20154 \u12434 \u36890 \u12376 \u12390 \u12398 \u32057 \u20171 \u12418 \u12289 \u32032 \u25973 \u12394 \u20986 \u20250 \u12356 \u12398 \u12365 \u12387 \u12363 \u12369 \u12398 \u19968 \u12388 \u12391 \u12377 \u12290 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u12371 \u12398 \u26041 \u27861 \u12391 \u12399 \u12289 \u12362 \u20114 \u12356 \u12395 \u20849 \u36890 \u12398 \u30693 \u20154 \u12364 \u12356 \u12427 \u12383 \u12417 \u12289 \u21021 \u23550 \u38754 \u12391 \u12418 \u30456 \u25163 \u12434 \u20449 \u38972 \u12375 \u12390 \u12522 \u12521 \u12483 \u12463 \u12473 \u12375 \u12383 \u38640 \u22258 \u27671 \u12391 \u12467 \u12511 \u12517 \u12491 \u12465 \u12540 \u12471 \u12519 \u12531 \u12434 \u22987 \u12417 \u12425 \u12428 \u12427 \u12513 \u12522 \u12483 \u12488 \u12364 \u12354 \u12426 \u12414 \u12377 \u12290 ",\
              "unconfident": true,\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12383 \u12384 \u12375 \u12289 \u21451 \u20154 \u12420 \u30693 \u20154 \u12398 \u32057 \u20171 \u12399 \u38480 \u12425 \u12428 \u12383 \u31684 \u22258 \u20869 \u12391 \u12398 \u20986 \u20250 \u12356 \u12392 \u12394 \u12427 \u12383 \u12417 \u12289 \u36984 \u25246 \u32930 \u12364 \u38480 \u12425 \u12428 \u12390 \u12375 \u12414 \u12358 \u12392 \u12356 \u12358 \u12487 \u12513 \u12522 \u12483 \u12488 \u12418 \u12354 \u12426 \u12414 \u12377 \u12290 \u33258 \u20998 \u12398 \u29702 \u24819 \u12395 \u21512 \u12358 \u30456 \u25163 \u12364 \u35211 \u12388 \u12363 \u12425 \u12394 \u12356 \u21487 \u33021 \u24615 \u12364 \u12354 \u12427 \u28857 \u12434 \u35226 \u12360 \u12390 \u12362 \u12365 \u12414 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "4\uc0\u20301 \u12288 \u32887 \u22580 \u12420 \u21462 \u24341 \u20808 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u32887 \u22580 \u12420 \u21462 \u24341 \u20808 \u12391 \u12398 \u20986 \u20250 \u12356 \u12418 \u12289 \u30495 \u38754 \u30446 \u12394 \u20132 \u38555 \u12364 \u22987 \u12414 \u12427 \u21487 \u33021 \u24615 \u12364 \u12354 \u12427 \u22580 \u25152 \u12391 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u20181 \u20107 \u19978 \u12391 \u12398 \u20986 \u20250 \u12356 \u12399 \u12289 \u20849 \u36890 \u12398 \u20181 \u20107 \u12434 \u36890 \u12376 \u12390 \u30456 \u25163 \u12398 \u20181 \u20107 \u12395 \u21521 \u12365 \u21512 \u12358 \u23039 \u21218 \u12384 \u12369 \u12391 \u12394 \u12367 \u12289 \u12503 \u12521 \u12452 \u12505 \u12540 \u12488 \u12394 \u20596 \u38754 \u12418 \u30693 \u12427 \u12371 \u12392 \u12364 \u12391 \u12365 \u12414 \u12377 \u12290 \u19968 \u32210 \u12395 \u36942 \u12372 \u12377 \u26178 \u38291 \u12364 \u22810 \u12356 \u12383 \u12417 \u12289 \u30456 \u25163 \u12398 \u24615 \u26684 \u12420 \u20385 \u20516 \u35251 \u12434 \u28145 \u12367 \u29702 \u35299 \u12377 \u12427 \u12371 \u12392 \u12418 \u21487 \u33021 \u12391 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12383 \u12384 \u12375 \u12289 \u20132 \u38555 \u12395 \u30330 \u23637 \u12375 \u12390 \u12418 \u12375 \u12394 \u12367 \u12390 \u12418 \u32887 \u22580 \u20869 \u12391 \u12398 \u20154 \u38291 \u38306 \u20418 \u12364 \u35079 \u38609 \u12395 \u12394 \u12427 \u21487 \u33021 \u24615 \u12364 \u12354 \u12427 \u12383 \u12417 \u12289 \u27880 \u24847 \u12364 \u24517 \u35201 \u12391 \u12377 \u12290 \u38306 \u20418 \u12364 \u36914 \u23637 \u12377 \u12427 \u21069 \u12395 \u21313 \u20998 \u12522 \u12473 \u12463 \u12434 \u32771 \u24942 \u12377 \u12427 \u12424 \u12358 \u12395 \u12375 \u12414 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "5\uc0\u20301 \u12288 \u32722 \u12356 \u20107 \u12420 \u36259 \u21619 \u12398 \u22580 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u20849 \u36890 \u12398 \u36259 \u21619 \u12434 \u25345 \u12388 \u20154 \u12293 \u12364 \u38598 \u12414 \u12427 \u36259 \u21619 \u12420 \u32722 \u12356 \u20107 \u12398 \u22580 \u12395 \u12418 \u12289 \u30495 \u38754 \u30446 \u12394 \u20986 \u20250 \u12356 \u12398 \u12481 \u12515 \u12531 \u12473 \u12364 \u12354 \u12426 \u12414 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12371 \u12358 \u12375 \u12383 \u22580 \u25152 \u12391 \u12399 \u12289 \u20849 \u36890 \u12398 \u36259 \u21619 \u12434 \u36890 \u12376 \u12390 \u27005 \u12375 \u12356 \u26178 \u38291 \u12434 \u36942 \u12372 \u12377 \u12371 \u12392 \u12391 \u12289 \u35242 \u23494 \u12394 \u38306 \u20418 \u12434 \u31689 \u12365 \u12420 \u12377 \u12367 \u12394 \u12426 \u12414 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12375 \u12363 \u12375 \u12289 \u32722 \u12356 \u20107 \u12434 \u30446 \u30340 \u12392 \u12375 \u12390 \u12356 \u12427 \u22580 \u25152 \u12391 \u12354 \u12427 \u12371 \u12392 \u12434 \u24847 \u35672 \u12375 \u12289 \u28961 \u29702 \u12395 \u38306 \u20418 \u12434 \u36914 \u23637 \u12373 \u12379 \u12424 \u12358 \u12392 \u12377 \u12427 \u12398 \u12399 \u36991 \u12369 \u12427 \u12409 \u12365 \u12391 \u12377 \u12290 \u36259 \u21619 \u12420 \u32722 \u12356 \u20107 \u12398 \u22580 \u12391 \u12399 \u12289 \u33258 \u28982 \u20307 \u12391 \u12467 \u12511 \u12517 \u12491 \u12465 \u12540 \u12471 \u12519 \u12531 \u12434 \u27005 \u12375 \u12435 \u12391 \u12289 \u20849 \u36890 \u12398 \u33288 \u21619 \u12434 \u27005 \u12375 \u12415 \u12394 \u12364 \u12425 \u12376 \u12387 \u12367 \u12426 \u12392 \u38306 \u20418 \u24615 \u12434 \u31689 \u12356 \u12390 \u12356 \u12367 \u12371 \u12392 \u12434 \u24515 \u12364 \u12369 \u12414 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "6\uc0\u20301 \u12288 \u12510 \u12483 \u12481 \u12531 \u12464 \u12450 \u12503 \u12522 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u12510 \u12483 \u12481 \u12531 \u12464 \u12450 \u12503 \u12522 \u12399 \u12289 \u24537 \u12375 \u12356 \u29694 \u20195 \u31038 \u20250 \u12391 \u30495 \u21091 \u12394 \u20986 \u20250 \u12356 \u12434 \u27714 \u12417 \u12427 \u20154 \u12395 \u12392 \u12387 \u12390 \u20415 \u21033 \u12394 \u12484 \u12540 \u12523 \u12391 \u12377 \u12290 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u12503 \u12525 \u12501 \u12451 \u12540 \u12523 \u12420 \u33288 \u21619 \u12434 \u12418 \u12392 \u12395 \u30456 \u24615 \u12398 \u33391 \u12356 \u30456 \u25163 \u12434 \u25506 \u12379 \u12427 \u12383 \u12417 \u12289 \u33258 \u20998 \u12398 \u24076 \u26395 \u26465 \u20214 \u12420 \u36259 \u21619 \u12364 \u21512 \u12358 \u20154 \u12392 \u20986 \u20250 \u12356 \u12420 \u12377 \u12367 \u12394 \u12426 \u12414 \u12377 \u12290 \u12414 \u12383 \u12289 \u22810 \u12367 \u12398 \u21033 \u29992 \u32773 \u12364 \u12356 \u12427 \u28857 \u12418 \u39749 \u21147 \u12391 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u19968 \u26041 \u12391 \u12289 \u12510 \u12483 \u12481 \u12531 \u12464 \u12450 \u12503 \u12522 \u12391 \u12399 \u12503 \u12525 \u12501 \u12451 \u12540 \u12523 \u12384 \u12369 \u12391 \u30456 \u25163 \u12434 \u21028 \u26029 \u12377 \u12427 \u12383 \u12417 \u12289 \u23455 \u38555 \u12398 \u30456 \u24615 \u12420 \u39749 \u21147 \u12364 \u20253 \u12431 \u12426 \u12395 \u12367 \u12356 \u12371 \u12392 \u12364 \u12354 \u12426 \u12414 \u12377 \u12290 \u12414 \u12383 \u12289 \u24180 \u21454 \u12420 \u32080 \u23130 \u27508 \u12394 \u12393 \u12398 \u32076 \u12434 \u35408 \u31216 \u12375 \u12390 \u12356 \u12427 \u20107 \u20363 \u12418 \u12354 \u12427 \u12383 \u12417 \u12289 \u20250 \u12358 \u21069 \u12395 \u12375 \u12387 \u12363 \u12426 \u12513 \u12483 \u12475 \u12540 \u12472 \u12434 \u12420 \u12426 \u12392 \u12426 \u12375 \u12390 \u20449 \u38972 \u12391 \u12365 \u12427 \u30456 \u25163 \u12363 \u12393 \u12358 \u12363 \u12434 \u21028 \u26029 \u12377 \u12427 \u12371 \u12392 \u12364 \u22823 \u20999 \u12391 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12510 \u12483 \u12481 \u12531 \u12464 \u12450 \u12503 \u12522 \u12398 \u21033 \u29992 \u12434 \u12377 \u12427 \u38555 \u12398 \u27880 \u24847 \u28857 \u12395 \u12388 \u12356 \u12390 \u35443 \u12375 \u12367 \u30693 \u12426 \u12383 \u12356 \u26041 \u12399 \u12289 \u19979 \u35352 \u12398 \u35352 \u20107 \u12434 \u21442 \u32771 \u12395 \u12375 \u12390 \u12415 \u12390 \u12367 \u12384 \u12373 \u12356 \u12290 ",\
              "unconfident": true,\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12510 \u12483 \u12481 \u12531 \u12464 \u12450 \u12503 \u12522 \u12364 \u12358 \u12414 \u12367 \u12356 \u12363 \u12394 \u12356 \u29702 \u30001 10\u36984 \u65372 \u12381 \u12398 \u23550 \u20966 \u27861 \u12392 \u27880 \u24847 \u12377 \u12409 \u12365 \u12509 \u12452 \u12531 \u12488 ",\
              "referred": false\
            \},\
            \{\
              "text": "7\uc0\u20301 \u12288 \u32080 \u23130 \u24335 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u32080 \u23130 \u24335 \u12391 \u12399 \u12289 \u21451 \u20154 \u12420 \u23478 \u26063 \u12395 \u12424 \u12427 \u32057 \u20171 \u12434 \u36890 \u12376 \u12390 \u26032 \u12375 \u12356 \u20986 \u20250 \u12356 \u12364 \u29983 \u12414 \u12428 \u12427 \u12371 \u12392 \u12418 \u12354 \u12426 \u12414 \u12377 \u12290 \u21916 \u12403 \u12420 \u24184 \u12379 \u12398 \u38640 \u22258 \u27671 \u12364 \u33391 \u12356 \u21360 \u35937 \u12434 \u19982 \u12360 \u12289 \u38306 \u20418 \u24615 \u12434 \u30330 \u23637 \u12373 \u12379 \u12427 \u12398 \u12395 \u24441 \u31435 \u12388 \u12371 \u12392 \u12418 \u12354 \u12427 \u12398 \u12391 \u12377 \u12290 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u12383 \u12384 \u12375 \u12289 \u32080 \u23130 \u24335 \u12399 \u12362 \u31069 \u12356 \u12398 \u22580 \u12391 \u12354 \u12427 \u12383 \u12417 \u12289 \u28961 \u29702 \u12395 \u20986 \u20250 \u12356 \u12434 \u27714 \u12417 \u12427 \u12371 \u12392 \u12399 \u36991 \u12369 \u12414 \u12375 \u12423 \u12358 \u12290 \u12414 \u12383 \u12289 \u26178 \u38291 \u12364 \u38480 \u12425 \u12428 \u12390 \u12356 \u12427 \u22580 \u21512 \u12418 \u22810 \u12356 \u12383 \u12417 \u12289 \u12522 \u12521 \u12483 \u12463 \u12473 \u12375 \u12383 \u38640 \u22258 \u27671 \u12391 \u33258 \u28982 \u12394 \u12467 \u12511 \u12517 \u12491 \u12465 \u12540 \u12471 \u12519 \u12531 \u12434 \u27005 \u12375 \u12416 \u12371 \u12392 \u12434 \u24847 \u35672 \u12375 \u12390 \u12367 \u12384 \u12373 \u12356 \u12397 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "8\uc0\u20301 \u12288 \u21516 \u31379 \u20250 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u21516 \u31379 \u20250 \u12399 \u12289 \u26132 \u12398 \u21451 \u20154 \u12392 \u12398 \u20877 \u20250 \u12398 \u22580 \u12391 \u12354 \u12426 \u12289 \u30495 \u38754 \u30446 \u12394 \u20986 \u20250 \u12356 \u12364 \u12399 \u12376 \u12414 \u12427 \u12481 \u12515 \u12531 \u12473 \u12364 \u24195 \u12364 \u12387 \u12390 \u12356 \u12414 \u12377 \u12290 \u23398 \u29983 \u26178 \u20195 \u12398 \u24605 \u12356 \u20986 \u12434 \u20849 \u26377 \u12377 \u12427 \u12371 \u12392 \u12391 \u12289 \u20250 \u35441 \u12399 \u33258 \u28982 \u12395 \u30427 \u12426 \u19978 \u12364 \u12426 \u12289 \u24613 \u36895 \u12395 \u38306 \u20418 \u24615 \u12364 \u30330 \u23637 \u12377 \u12427 \u12371 \u12392 \u12418 \u12354 \u12427 \u12398 \u12391 \u12377 \u12290 ",\
              "referred": true\
            \},\
            \{\
              "text": "\uc0\u21516 \u31379 \u20250 \u12391 \u12399 \u27671 \u36000 \u12431 \u12378 \u12395 \u20250 \u35441 \u12391 \u12365 \u12427 \u12398 \u12391 \u12289 \u27671 \u36605 \u12395 \u21442 \u21152 \u12391 \u12365 \u12427 \u20986 \u20250 \u12356 \u12398 \u22580 \u12392 \u12375 \u12390 \u12289 \u32771 \u12360 \u12390 \u12362 \u12367 \u12392 \u33391 \u12356 \u12391 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u19968 \u22812 \u38480 \u12426 \u12395 \u12394 \u12426 \u12363 \u12397 \u12394 \u12356 \u27880 \u24847 \u12377 \u12409 \u12365 \u20986 \u20250 \u12356 \u12398 \u22580 \u65301 \u36984 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u30495 \u38754 \u30446 \u12394 \u20986 \u20250 \u12356 \u12392 \u12399 \u27491 \u21453 \u23550 \u12395 \u12289 \u19968 \u22812 \u38480 \u12426 \u12398 \u38306 \u20418 \u12364 \u29983 \u12414 \u12428 \u12420 \u12377 \u12356 \u20986 \u20250 \u12356 \u12398 \u22580 \u12418 \u23384 \u22312 \u12375 \u12414 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12381 \u12398 \u12424 \u12358 \u12394 \u22580 \u25152 \u12391 \u12398 \u20986 \u20250 \u12356 \u12399 \u12289 \u27005 \u12375 \u12356 \u19968 \u26178 \u12434 \u25552 \u20379 \u12375 \u12390 \u12367 \u12428 \u12427 \u21453 \u38754 \u12289 \u30495 \u21091 \u12394 \u38306 \u20418 \u12434 \u31689 \u12367 \u12398 \u12399 \u38627 \u12375 \u12356 \u22580 \u21512 \u12418 \u12354 \u12427 \u12383 \u12417 \u27880 \u24847 \u12364 \u24517 \u35201 \u12391 \u12377 \u12290 \u12371 \u12371 \u12363 \u12425 \u12399 \u12289 \u20855 \u20307 \u30340 \u12395 \u12393 \u12398 \u12424 \u12358 \u12394 \u22580 \u25152 \u12391 \u12398 \u20986 \u20250 \u12356 \u12395 \u27671 \u12434 \u12388 \u12369 \u12428 \u12400 \u33391 \u12356 \u12398 \u12363 \u35211 \u12390 \u12356 \u12365 \u12414 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12496 \u12540 \u12420 \u12463 \u12521 \u12502 \u12394 \u12393 \u12398 \u12490 \u12452 \u12488 \u12473 \u12509 \u12483 \u12488 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u12496 \u12540 \u12420 \u12463 \u12521 \u12502 \u12399 \u27005 \u12375 \u12356 \u22812 \u12434 \u36942 \u12372 \u12377 \u22580 \u12392 \u12375 \u12390 \u20154 \u27671 \u12391 \u12377 \u12364 \u12289 \u12450 \u12523 \u12467 \u12540 \u12523 \u12398 \u24433 \u38911 \u12391 \u29702 \u24615 \u12434 \u22833 \u12356 \u21028 \u26029 \u21147 \u12364 \u37389 \u12427 \u12371 \u12392 \u12391 \u12289 \u26222 \u27573 \u12398 \u33258 \u20998 \u12392 \u12399 \u36949 \u12387 \u12383 \u34892 \u21205 \u12420 \u30330 \u35328 \u12434 \u12375 \u12390 \u12375 \u12414 \u12358 \u24656 \u12428 \u12364 \u12354 \u12426 \u12414 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u34909 \u21205 \u30340 \u12395 \u27005 \u12375 \u12356 \u26178 \u38291 \u12434 \u36942 \u12372 \u12379 \u12383 \u12392 \u12375 \u12390 \u12418 \u12289 \u27425 \u12398 \u26085 \u12395 \u25105 \u12395 \u12363 \u12360 \u12387 \u12390 \u24460 \u24724 \u12375 \u12390 \u12375 \u12414 \u12358 \u12371 \u12392 \u12418 \u12354 \u12427 \u12363 \u12418 \u12375 \u12428 \u12414 \u12379 \u12435 \u12290 \u12381 \u12398 \u12424 \u12358 \u12394 \u20107 \u24907 \u12434 \u36991 \u12369 \u12427 \u12383 \u12417 \u12395 \u12418 \u12289 \u22810 \u37327 \u12398 \u12450 \u12523 \u12467 \u12540 \u12523 \u12434 \u25666 \u21462 \u12375 \u12394 \u12356 \u12424 \u12358 \u12395 \u24847 \u35672 \u12375 \u12390 \u12289 \u33258 \u20998 \u12398 \u12506 \u12540 \u12473 \u12391 \u27005 \u12375 \u12415 \u12394 \u12364 \u12425 \u12289 \u20581 \u20840 \u12394 \u12467 \u12511 \u12517 \u12491 \u12465 \u12540 \u12471 \u12519 \u12531 \u12434 \u24515 \u12364 \u12369 \u12427 \u12371 \u12392 \u12364 \u22823 \u20999 \u12391 \u12377 \u12290 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u28023 \u12420 \u12503 \u12540 \u12523 ",\
              "referred": false\
            \},\
            \{\
              "text": "\uc0\u28023 \u12420 \u12503 \u12540 \u12523 \u12391 \u12398 \u20986 \u20250 \u12356 \u12399 \u12289 \u32908 \u12398 \u38706 \u20986 \u12364 \u39640 \u12356 \u29366 \u27841 \u12395 \u12394 \u12427 \u12383 \u12417 \u12289 \u22806 \u35211 \u12398 \u12415 \u12395 \u27880 \u30446 \u12373 \u12428 \u12420 \u12377 \u12367 \u12394 \u12426 \u12414 \u12377 \u12290 \u12381 \u12398 \u12383 \u12417 \u12289 \u30495 \u21091 \u12394 \u20986 \u20250 \u12356 \u12434 \u27714 \u12417 \u12427 \u20154 \u12395 \u12392 \u12387 \u12390 \u12399 \u30456 \u25163 \u12398 \u26412 \u36074 \u12420 \u20385 \u20516 \u35251 \u12434 \u35211 \u26997 \u12417 \u12427 \u12398 \u12364 \u38627 \u12375 \u12367 \u12394 \u12427 \u21487 \u33021 \u24615 \u12364 \u12354 \u12427 \u12371 \u12392 \u12434 \u35226 \u12360 \u12390 \u12362 \u12365 \u12414 \u12375 \u12423 \u12358 \u12290 ",\
              "referred": false\
            \},\
            \{\
